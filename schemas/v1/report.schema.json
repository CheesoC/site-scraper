{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://site-scraper.local/schemas/v1/report.schema.json",
  "title": "Crawl reports (reports/*.json)",
  "oneOf": [{ "$ref": "#/$defs/crawlReport" }, { "$ref": "#/$defs/itemReport" }],
  "$defs": {
    "crawlReport": {
      "type": "object",
      "required": ["schemaVersion", "kind", "status", "stats"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "kind": { "const": "crawl" },
        "status": {
          "enum": ["complete", "limited", "errors"],
          "description": "complete = everything discovered was exported; limited = limits stopped the crawl; errors = some pages failed"
        },
        "startedAt": { "type": ["string", "null"] },
        "finishedAt": { "type": ["string", "null"] },
        "config": { "type": "object" },
        "limitsReached": { "type": "array", "items": { "type": "string" } },
        "stats": {
          "type": "object",
          "additionalProperties": { "type": "integer" }
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "message"],
            "properties": {
              "type": { "type": "string" },
              "message": { "type": "string" },
              "path": { "type": ["string", "null"] },
              "url": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "itemReport": {
      "type": "object",
      "required": ["schemaVersion", "kind", "items"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "kind": { "enum": ["failed-urls", "broken-links", "missing-assets"] },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["url"],
            "properties": {
              "url": { "type": "string" },
              "status": { "type": ["integer", "null"] },
              "error": { "type": ["string", "null"] },
              "page": { "type": ["string", "null"], "description": "Path of the page where it was referenced" },
              "path": { "type": ["string", "null"] }
            }
          }
        }
      }
    }
  }
}
